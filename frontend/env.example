VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Version info (optional overrides; see vite.config.ts `define`).
# Defaults: version from package.json, build id from Vercel's commit SHA or
# local git, environment from VERCEL_ENV / the Vite mode.
VITE_APP_VERSION=
VITE_BUILD_ID=

# Media limits
VITE_MAX_UPLOAD_FILES=10
VITE_MAX_SELECTED_FILES=5

# SEO — canonical site origin (no trailing slash). Used for canonicals,
# Open Graph URLs, sitemap.xml, robots.txt, and llms.txt.
VITE_SITE_URL=https://studyassistant.app

# Search-console verification (optional; injected as meta tags at build time)
# Google Search Console "HTML tag" method — content value only:
VITE_GSC_VERIFICATION=
# Bing Webmaster Tools msvalidate.01 — content value only:
VITE_BING_VERIFICATION=

# Analytics — see src/lib/analytics/README.md. Loaded async whenever a
# provider key is set, dev included; every event carries `app_env`
# (production / preview / development) so dashboards can filter. Prefer a
# separate PostHog project key per Vercel environment, and leave the key
# blank locally to keep local traffic out of the dashboards.
# PostHog project API key (phc_...):
VITE_POSTHOG_KEY=
# PostHog ingestion host; defaults to US Cloud. Use
# https://eu.i.posthog.com for EU Cloud or your self-hosted origin.
VITE_POSTHOG_HOST=
# Master switch (default: on when a provider key is set). "false" disables
# every provider; events still print in debug mode.
VITE_ANALYTICS_ENABLED=
# Console logging of every event. Defaults to on for non-production builds;
# "true"/"false" forces it. Per-browser override: localStorage
# aeva_analytics_debug=1 (or `window.__aeva_analytics.debug = true`).
VITE_ANALYTICS_DEBUG=
# Google Analytics 4 measurement id — RESERVED, not loaded yet (a GA provider
# is a planned follow-up to the analytics SDK):
VITE_GA_MEASUREMENT_ID=
