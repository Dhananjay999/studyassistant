VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Media limits
VITE_MAX_UPLOAD_FILES=10
VITE_MAX_SELECTED_FILES=5

# SEO — canonical site origin (no trailing slash). Used for canonicals,
# Open Graph URLs, sitemap.xml, robots.txt, and llms.txt.
VITE_SITE_URL=https://studyassistant.app

# Search-console verification (optional; injected as meta tags at build time)
# Google Search Console "HTML tag" method — content value only:
VITE_GSC_VERIFICATION=
# Bing Webmaster Tools msvalidate.01 — content value only:
VITE_BING_VERIFICATION=

# Analytics (optional; loaded async in production builds only)
# Google Analytics 4 measurement id (G-XXXXXXXXXX):
VITE_GA_MEASUREMENT_ID=
# Microsoft Clarity project id:
VITE_CLARITY_ID=
