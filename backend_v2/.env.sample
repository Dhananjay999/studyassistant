# Supabase
SUPABASE_URL=https://tadooavkfngedliceqjy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_GtqXy66W0rC9UibcXmGWIA_V9ix4Awz
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_STORAGE_BUCKET=study_media

GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# OpenAI (optional). Leave OPENAI_API_KEY blank to keep OpenAI disabled.
OPENAI_API_KEY=
# Blank uses OpenAI's default endpoint; set it for Azure/OpenAI-compatible gateways.
OPENAI_BASE_URL=

# Default model for all capabilities (used when a specific model is not set).
LLM_MODEL=gemini-2.5-flash

# Optional per-capability models (each falls back to LLM_MODEL).
LLM_ORCHESTRATOR_MODEL=gemini-2.5-flash
LLM_WEB_SEARCH_MODEL=gemini-2.5-flash
LLM_MEDIA_MODEL=gemini-2.5-flash
LLM_QUIZ_MODEL=gemini-2.5-flash
# Quiz performance analysis (POST /quiz/<id>/analyze). Falls back to
# LLM_QUIZ_MODEL when unset — set it to run analysis on a different model.
LLM_QUIZ_ANALYSIS_MODEL=gemini-2.5-flash
LLM_FLASHCARD_MODEL=gemini-2.5-flash
LLM_EMBEDDING_MODEL=gemini-embedding-001

# Per-tool candidate models for planner-driven model selection (comma-separated,
# cheapest -> strongest). The orchestrator shows these to the planner, which
# returns one `model` per request — the cheapest that can answer well. Leave
# blank to keep the single LLM_*_MODEL above (no per-request selection).
# NOTE (v1): keep each list within ONE provider — a tool's provider is still
# fixed by its LLM_*_PROVIDER, so mixing vendors in one list would fail.
# GENERAL_LLM_MODELS=gemini-2.5-flash,gemini-2.5-pro
# WEB_SEARCH_LLM_MODELS=gemini-2.5-flash,gemini-2.5-pro
# MEDIA_LLM_MODELS=gemini-2.5-flash,gemini-2.5-pro
# QUIZ_LLM_MODELS=gemini-2.5-flash,gemini-2.5-pro
# FLASHCARD_LLM_MODELS=gemini-2.5-flash

# Dev/QA: append "powered by: <model>" to each answer so you can see which model
# the planner picked. Leave blank/false in production.
SHOW_MODEL_BADGE=false
# LLM provider per capability. Providers wired in today: "gemini", "groq", "openai".
# Web search grounding (with sources/citations) is supported on "gemini"
# (Google Search) and "openai" (Responses API web_search tool); "groq" ignores
# search and returns no sources.
LLM_PROVIDER=gemini
LLM_ORCHESTRATOR_PROVIDER=gemini
LLM_WEB_SEARCH_PROVIDER=gemini
LLM_MEDIA_PROVIDER=gemini
LLM_QUIZ_PROVIDER=gemini
# Provider for quiz analysis; falls back to LLM_QUIZ_PROVIDER when unset.
LLM_QUIZ_ANALYSIS_PROVIDER=gemini
LLM_FLASHCARD_PROVIDER=gemini
LLM_EMBEDDING_PROVIDER=gemini

# Media RAG pipeline (LlamaParse + pgvector). LLAMA_CLOUD_API_KEY is optional:
# leave it blank to disable document parsing — the media tool then falls back to
# sending files directly to the LLM (the pre-RAG behavior), so the app still
# boots. Get a key at https://cloud.llamaindex.ai. LLAMAPARSE_MODE is the parse
# tier: cost_effective | agentic | agentic_plus (agentic tiers OCR images and
# handwriting). RAG_EMBEDDING_DIM MUST match the vector(N) column in migration
# 007 and the embedding output dimensionality.
LLAMA_CLOUD_API_KEY=
LLAMAPARSE_MODE=fast
RAG_EMBEDDING_DIM=768
RAG_TOP_K=8
RAG_CHUNK_TOKENS=512
RAG_CHUNK_OVERLAP=64
# Answer not-yet-indexed docs from raw attachments instead of refusing. Set to
# false once all uploads are indexed to enforce retrieval-only answers.
RAG_ATTACHMENT_FALLBACK=true

GROQ_MAX_TOKENS=4096
GROQ_REASONING_EFFORT=low

# OpenAI tuning. OPENAI_MAX_TOKENS=0 lets OpenAI size the completion; set a
# positive cap to bound cost/latency. OPENAI_REASONING_EFFORT applies to
# reasoning models ("minimal"/"low"/"medium"/"high"); blank omits it.
OPENAI_MAX_TOKENS=0
OPENAI_REASONING_EFFORT=

# Max questions per generated quiz
QUIZ_MAX_QUESTIONS=25

# Logging. LOG_LEVEL sets the app verbosity (DEBUG shows prompts, payloads, and
# request bodies; INFO is a clean lifecycle trace). LOG_HTTP_LEVEL controls the
# httpx logger, which prints one line per outbound HTTP call — every LLM API and
# Supabase REST/storage request. Set it to WARNING to silence those.
# LOG_LLM_REQUESTS=true logs the full, untruncated request for every LLM call
# (resolved system prompt, history, attachments, user message, and schema) at
# INFO — independent of LOG_LEVEL. Leave off in production; it is very verbose.
LOG_LEVEL=INFO
LOG_HTTP_LEVEL=INFO
LOG_LLM_REQUESTS=false
# PROMPT_DEBUG=true logs every fully rendered prompt (each template with all
# placeholders resolved, split by system/history/user channel) right before it
# is sent to the LLM. Independent of the flags above; off by default.
PROMPT_DEBUG=false

# App
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=10

# OAuth (backend-driven Google login)
# Where the backend redirects the browser after a successful login.
FRONTEND_URL=http://localhost:5173
# Set to true in production (HTTPS) so the PKCE cookie is Secure.
COOKIE_SECURE=false
# Lifetime of the OAuth PKCE cookie (seconds).
PKCE_COOKIE_MAX_AGE_SECONDS=600
# Validity window for storage signed URLs (seconds).
MEDIA_SIGNED_URL_TTL_SECONDS=3600

# Super Admin panel (optional).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
# Lifetime of the admin JWT the app issues (days; default 30 = 30 days).
ADMIN_TOKEN_EXPIRE_DAYS=30
